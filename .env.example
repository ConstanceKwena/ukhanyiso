# Local development settings. Spring Boot reads these from the process environment.
# This project currently needs no credentials or external service keys.
SERVER_PORT=8080
# Password-reset email (optional). Leave MAIL_ENABLED unset for local dev.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ukhanyiso.org
